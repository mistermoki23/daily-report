# Campaign Monitor — environment template
# Copy values into .env.local. Never commit real secrets.

# --- Auth (required) ---
# Min 16 characters. Used to sign httpOnly session JWT.
AUTH_SECRET=

# --- PostgreSQL via Supabase (Prisma) ---
# App runtime — prefer Transaction pooler (port 6543, ?pgbouncer=true)
DATABASE_URL=

# Migrations — Direct or Session connection (port 5432, no pgbouncer)
# Can be the same as DATABASE_URL if you only use the direct host.
DIRECT_URL=

# Set to "false" (or omit) when using Supabase/Postgres.
# "true" forces the local JSON store in /data (local demo only).
USE_LOCAL_DB=false

# Project ref (optional, documentation only — not used by Prisma)
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

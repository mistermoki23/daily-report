# Campaign Monitor — environment template
# Copy to .env / .env.local and fill in values. Never commit real secrets.

# --- Auth ---
# Required in production (min 16 chars). Used to sign httpOnly session JWT.
AUTH_SECRET="replace-with-a-long-random-string"

# --- Database ---
# Required for Prisma on Vercel / production.
# Local demo without Postgres: set USE_LOCAL_DB=true (JSON store in /data).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/campaign_monitor?schema=public"

# Force local JSON store even if DATABASE_URL is set (local MVP only; not for Vercel)
USE_LOCAL_DB=true

# Optional — legacy Supabase (unused when Prisma DATABASE_URL is configured)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

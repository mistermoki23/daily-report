# Campaign Monitor — environment template
# Local: copy to .env.local (never commit real secrets).
# Vercel: set the same keys in Project Settings → Environment Variables
#         for Production (and Preview if needed), then Redeploy.
#         `.env.local` is NOT uploaded to Vercel.

# --- Auth (required) ---
# Min 16 characters. Used to sign httpOnly session JWT.
AUTH_SECRET=

# --- PostgreSQL via Supabase (Prisma) ---
# App runtime — prefer Transaction pooler (port 6543, ?pgbouncer=true)
# Must be a non-empty connection string on Vercel (empty DATABASE_URL= causes Prisma errors).
DATABASE_URL=

# Migrations / Prisma migrate — Session or Direct (port 5432, no pgbouncer)
# Required by prisma/schema.prisma (directUrl). Set on Vercel too.
DIRECT_URL=

# Must be false (or omit) on Vercel / when using Supabase.
# "true" is local-only JSON demo and is disabled on Vercel in code.
USE_LOCAL_DB=false

# --- Supabase Storage (campaign screenshots) ---
# Optional if DATABASE_URL / DIRECT_URL is a Supabase pooler/direct URL
# (project ref is derived automatically). Set explicitly if derivation fails.
# SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
#
# Required for uploads on Vercel and locally. Server-only — never NEXT_PUBLIC_.
# Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=
#
# Private bucket `campaign-screenshots` is created on first upload if the
# service role can create buckets. Otherwise run:
#   supabase/storage-campaign-screenshots.sql
# in Supabase → SQL Editor.

# --- Vercel Production checklist ---
# Add for Environment: Production (enable Preview too if you use PR previews):
#   DATABASE_URL              = Supabase pooler URL (6543, ?pgbouncer=true)
#   DIRECT_URL                = Supabase session/direct URL (5432)
#   AUTH_SECRET               = long random secret (openssl rand -base64 48)
#   USE_LOCAL_DB              = false
#   SUPABASE_SERVICE_ROLE_KEY = service_role (Storage uploads; never expose to the browser)
# After saving, trigger Redeploy. Empty values are invalid — do not leave DATABASE_URL blank.

// Campaign Monitor — PostgreSQL schema (Prisma)
// Calculated plan/fact metrics are derived in app code, not stored.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CampaignStatus {
  on_track
  attention
  critical
  completed
}

enum KpiType {
  impressions
  reach
  clicks
  spend
  conversions
  video_views
}

enum CurrencyCode {
  RUB
  USD
  EUR
  UZS
  KZT
  GBP
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("employee")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Client {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  campaigns Campaign[]

  @@map("clients")
}

model Platform {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  campaigns Campaign[]

  @@map("platforms")
}

model Campaign {
  id         String         @id @default(uuid()) @db.Uuid
  name       String
  clientId   String         @map("client_id") @db.Uuid
  platformId String         @map("platform_id") @db.Uuid
  currency   CurrencyCode   @default(RUB)
  startDate  DateTime       @map("start_date") @db.Date
  endDate    DateTime       @map("end_date") @db.Date
  status     CampaignStatus @default(attention)
  primaryKpi KpiType        @default(impressions) @map("primary_kpi")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  client  Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  platform Platform    @relation(fields: [platformId], references: [id], onDelete: Restrict)
  plan    CampaignPlan?
  dailyData DailyData[]

  @@index([clientId])
  @@index([platformId])
  @@index([startDate, endDate])
  @@map("campaigns")
}

/// Campaign plan KPIs (one row per campaign).
/// Plan CPM/CTR/CPC/VTR/CPA/Frequency are calculated in application code.
model CampaignPlan {
  id           String   @id @default(uuid()) @db.Uuid
  campaignId   String   @unique @map("campaign_id") @db.Uuid
  impressions  Decimal? @db.Decimal(18, 4)
  reach        Decimal? @db.Decimal(18, 4)
  clicks       Decimal? @db.Decimal(18, 4)
  spend        Decimal? @db.Decimal(18, 4)
  videoViews   Decimal? @map("video_views") @db.Decimal(18, 4)
  conversions  Decimal? @db.Decimal(18, 4)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("campaign_plans")
}

model DailyData {
  id              String    @id @default(uuid()) @db.Uuid
  campaignId      String    @map("campaign_id") @db.Uuid
  date            DateTime  @db.Date
  impressions     Decimal?  @db.Decimal(18, 4)
  reachCumulative Decimal?  @map("reach_cumulative") @db.Decimal(18, 4)
  clicks          Decimal?  @db.Decimal(18, 4)
  spend           Decimal?  @db.Decimal(18, 4)
  videoViews      Decimal?  @map("video_views") @db.Decimal(18, 4)
  conversions     Decimal?  @db.Decimal(18, 4)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
  @@index([campaignId, date])
  @@map("daily_data")
}

// Campaign Monitor — PostgreSQL schema (Prisma)
// Calculated plan/fact metrics are derived in app code, not stored.
// "Report" in admin ACL maps to Campaign.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled URL for app runtime (Supabase pooler / Transaction mode)
  url       = env("DATABASE_URL")
  // Direct URL for migrations (Supabase Session/Direct — no pgbouncer)
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  MANAGER
  READER
  ADMIN
}

enum CampaignStatus {
  on_track
  attention
  critical
  completed
}

enum KpiType {
  impressions
  reach
  clicks
  spend
  conversions
  video_views
}

enum CurrencyCode {
  RUB
  USD
  EUR
  UZS
  KZT
  GBP
}

enum ActivityAction {
  LOGIN
  LOGOUT
  REPORT_OPENED
  REPORT_STARTED
  REPORT_UPDATED
  REPORT_COMPLETED
  PLAN_UPDATED
}

model User {
  id           String           @id @default(uuid()) @db.Uuid
  name         String
  email        String           @unique
  passwordHash String           @map("password_hash")
  role         UserRole         @default(USER)
  lastLoginAt  DateTime?        @map("last_login_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  campaigns    Campaign[]
  reportAccess ReportAccess[]
  activities   ReportActivity[]
  planChanges  PlanChangeLog[]
  changeLogs   CampaignChangeLog[]
  screenshots  CampaignScreenshot[]

  @@map("users")
}

model Client {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  brands    Brand[]
  campaigns Campaign[]

  @@map("clients")
}

model Brand {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  clientId  String     @map("client_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@unique([clientId, name])
  @@index([clientId])
  @@map("brands")
}

model Platform {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  campaigns Campaign[]

  @@map("platforms")
}

model Campaign {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  name       String
  clientId   String         @map("client_id") @db.Uuid
  brandId    String?        @map("brand_id") @db.Uuid
  platformId String         @map("platform_id") @db.Uuid
  currency   CurrencyCode   @default(RUB)
  startDate  DateTime       @map("start_date") @db.Date
  endDate    DateTime       @map("end_date") @db.Date
  status     CampaignStatus @default(attention)
  primaryKpi KpiType        @default(impressions) @map("primary_kpi")
  deletedAt  DateTime?      @map("deleted_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  client      Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  brand       Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  platform    Platform            @relation(fields: [platformId], references: [id], onDelete: Restrict)
  plan        CampaignPlan?
  dailyData   DailyData[]
  accesses    ReportAccess[]
  activities  ReportActivity[]
  planChanges PlanChangeLog[]
  changeLogs  CampaignChangeLog[]
  screenshots CampaignScreenshot[]

  @@index([userId])
  @@index([clientId])
  @@index([brandId])
  @@index([platformId])
  @@index([startDate, endDate])
  @@index([deletedAt])
  @@map("campaigns")
}

/// Campaign plan KPIs (one row per campaign).
/// Plan CPM/CTR/CPC/VTR/CPA/Frequency are calculated in application code.
model CampaignPlan {
  id          String   @id @default(uuid()) @db.Uuid
  campaignId  String   @unique @map("campaign_id") @db.Uuid
  impressions Decimal? @db.Decimal(18, 4)
  reach       Decimal? @db.Decimal(18, 4)
  clicks      Decimal? @db.Decimal(18, 4)
  spend       Decimal? @db.Decimal(18, 4)
  videoViews  Decimal? @map("video_views") @db.Decimal(18, 4)
  conversions Decimal? @db.Decimal(18, 4)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("campaign_plans")
}

model DailyData {
  id              String    @id @default(uuid()) @db.Uuid
  campaignId      String    @map("campaign_id") @db.Uuid
  date            DateTime  @db.Date
  impressions     Decimal?  @db.Decimal(18, 4)
  reachCumulative Decimal?  @map("reach_cumulative") @db.Decimal(18, 4)
  clicks          Decimal?  @db.Decimal(18, 4)
  spend           Decimal?  @db.Decimal(18, 4)
  videoViews      Decimal?  @map("video_views") @db.Decimal(18, 4)
  conversions     Decimal?  @db.Decimal(18, 4)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
  @@index([campaignId, date])
  @@map("daily_data")
}

/// Grants a user access to a campaign ("report").
model ReportAccess {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  reportId  String   @map("report_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  report Campaign @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([userId, reportId])
  @@index([userId])
  @@index([reportId])
  @@map("report_access")
}

model ReportActivity {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  reportId  String?        @map("report_id") @db.Uuid
  action    ActivityAction
  createdAt DateTime       @default(now()) @map("created_at")

  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  report Campaign? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([reportId, createdAt])
  @@index([action, createdAt])
  @@map("report_activity")
}

/// Audit log for campaign plan KPI edits (old → new per field).
model PlanChangeLog {
  id         String   @id @default(uuid()) @db.Uuid
  campaignId String   @map("campaign_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  userEmail  String   @map("user_email")
  field      String
  oldValue   Decimal? @map("old_value") @db.Decimal(18, 4)
  newValue   Decimal? @map("new_value") @db.Decimal(18, 4)
  createdAt  DateTime @default(now()) @map("created_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("plan_change_logs")
}

enum CampaignChangeAction {
  EDIT
  DELETE
  RESTORE
}

enum CampaignScreenshotType {
  LAUNCH
  REPORTING
}

/// General campaign audit log (meta fields + DELETE/RESTORE). Plan KPI edits also stay in plan_change_logs.
model CampaignChangeLog {
  id         String                @id @default(uuid()) @db.Uuid
  campaignId String                @map("campaign_id") @db.Uuid
  userId     String                @map("user_id") @db.Uuid
  userEmail  String                @map("user_email")
  action     CampaignChangeAction
  field      String
  oldValue   String?               @map("old_value")
  newValue   String?               @map("new_value")
  createdAt  DateTime              @default(now()) @map("created_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("campaign_change_logs")
}

/// Confirming screenshots for a campaign (launch / reporting placement).
/// Image bytes live on disk; only URL + metadata are stored here.
model CampaignScreenshot {
  id           String                  @id @default(uuid()) @db.Uuid
  campaignId   String                  @map("campaign_id") @db.Uuid
  type         CampaignScreenshotType
  url          String
  storageKey   String                  @map("storage_key")
  originalName String?                 @map("original_name")
  mimeType     String                  @map("mime_type")
  sizeBytes    Int                     @map("size_bytes")
  uploadedBy   String                  @map("uploaded_by") @db.Uuid
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  uploader User     @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@unique([campaignId, type])
  @@index([campaignId])
  @@index([uploadedBy])
  @@map("campaign_screenshots")
}
